---
// USWDS-aligned Statutory Summary Box (usa-summary-box)
interface Props {
  classification: string;
  uscTitle: number | string;
  uscSection: string;
  chapter: number;
  currentThrough: string;
  status?: string;
  readingTimeMin?: number;
  lastUpdated?: string;
  olrcUrl: string;
}

const {
  classification,
  uscTitle,
  uscSection,
  chapter,
  currentThrough,
  status = 'active',
  readingTimeMin,
  lastUpdated,
  olrcUrl,
} = Astro.props;

const isRepealed = status === 'repealed';
const isTransferred = status === 'transferred';
const isRenumbered = status === 'renumbered';
const isOmitted = status === 'omitted';
const isReserved = status === 'reserved';

const borderAccent = isRepealed
  ? 'border-[var(--legal-invalid)] bg-[var(--legal-invalid-bg)]'
  : isTransferred || isRenumbered || isOmitted || isReserved
  ? 'border-[var(--legal-caution)] bg-[var(--legal-caution-bg)]'
  : 'border-[var(--legal-valid)] bg-[var(--legal-valid-bg)]';

const statusBadge = isRepealed
  ? { label: 'Repealed', class: 'bg-[var(--legal-invalid-bg)] text-[var(--legal-invalid)]' }
  : isTransferred
  ? { label: 'Transferred', class: 'bg-[var(--legal-caution-bg)] text-[var(--legal-caution)]' }
  : isRenumbered
  ? { label: 'Renumbered', class: 'bg-[var(--legal-caution-bg)] text-[var(--legal-caution)]' }
  : isOmitted
  ? { label: 'Omitted', class: 'bg-gray-200 text-slate dark:bg-gray-800 dark:text-gray-300' }
  : isReserved
  ? { label: 'Reserved', class: 'bg-gray-200 text-slate dark:bg-gray-800 dark:text-gray-300' }
  : { label: 'In Force', class: 'bg-[var(--legal-valid-bg)] text-[var(--legal-valid)]' };
---

<div
  role="region"
  aria-label="Statutory metadata overview"
  class:list={[
    'not-prose my-6 rounded-r-lg border-l-4 p-4 font-sans shadow-xs transition-colors',
    borderAccent,
  ]}
>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-subtle)] pb-3">
    <div class="flex items-center gap-2">
      <span class="text-sm font-bold tracking-tight text-[var(--text-primary)]">
        {classification}
      </span>
      <span class:list={['inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider', statusBadge.class]}>
        {statusBadge.label}
      </span>
    </div>
    <div class="flex items-center gap-1.5 text-xs">
      <button
        id="copy-cite-btn"
        data-citation={classification}
        class="inline-flex items-center gap-1 rounded bg-[var(--surface-raised)] px-2.5 py-1 text-xs font-medium text-[var(--text-primary)] shadow-2xs hover:opacity-90 border border-[var(--border-default)] cursor-pointer"
        aria-label="Copy citation to clipboard"
      >
        <svg class="h-3.5 w-3.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span id="copy-cite-label">Copy cite</span>
      </button>

      <a
        href={olrcUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded bg-[var(--surface-sunken)] px-2.5 py-1 text-xs font-medium text-[var(--civic-action)] border border-[var(--border-subtle)] hover:border-[var(--civic-action)] transition-colors"
        aria-label={`View § ${uscSection} on the Official U.S. Code, opens in new tab`}
        title="Official House OLRC legislative XML"
      >
        <span>OLRC</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <a
        href={`https://www.govinfo.gov/link/uscode/${uscTitle}/${uscSection}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded bg-[var(--surface-sunken)] px-2.5 py-1 text-xs font-medium text-[var(--civic-action)] border border-[var(--border-subtle)] hover:border-[var(--civic-action)] transition-colors"
        aria-label={`Download official authenticated GPO PDF for § ${uscSection}, opens in new tab`}
        title="Official GPO Authenticated PDF (GovInfo Link Service)"
      >
        <svg class="h-3 w-3 text-[var(--civic-action)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>GPO PDF</span>
      </a>

      <a
        href={`https://www.law.cornell.edu/uscode/text/${uscTitle}/${uscSection}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded bg-[var(--surface-sunken)] px-2.5 py-1 text-xs font-medium text-[var(--civic-action)] border border-[var(--border-subtle)] hover:border-[var(--civic-action)] transition-colors"
        aria-label={`Compare § ${uscSection} on Cornell Law School LII, opens in new tab`}
        title="Compare on Cornell Legal Information Institute (LII)"
      >
        <span>Cornell LII</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <button
        id="print-section-btn"
        type="button"
        class="inline-flex items-center gap-1 rounded bg-[var(--surface-raised)] px-2 py-1 text-xs text-[var(--text-secondary)] shadow-2xs hover:opacity-90 border border-[var(--border-default)] cursor-pointer"
        aria-label="Print this section"
      >
        <svg class="h-3.5 w-3.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate dark:text-gray-400">
    <span class="rounded bg-navy/10 px-2 py-0.5 font-medium text-navy dark:bg-amber/10 dark:text-amber">
      Title {uscTitle}
    </span>
    <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
      Chapter {chapter}
    </span>
    <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
      Current through {currentThrough}
    </span>
    {readingTimeMin && (
      <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-700 dark:bg-gray-800 dark:text-gray-300">
        ~{readingTimeMin} min read
      </span>
    )}
    {lastUpdated && (
      <span class="text-gray-500 dark:text-gray-500">
        Last updated: {lastUpdated}
      </span>
    )}
  </div>
</div>

<script is:inline>
  (function() {
    var copyBtn = document.getElementById('copy-cite-btn');
    var label = document.getElementById('copy-cite-label');
    if (copyBtn && label) {
      copyBtn.addEventListener('click', function() {
        var citation = copyBtn.getAttribute('data-citation');
        if (!citation) return;
        navigator.clipboard.writeText(citation).then(function() {
          label.textContent = 'Copied!';
          setTimeout(function() {
            label.textContent = 'Copy cite';
          }, 2000);
        }).catch(function() {});
      });
    }

    var printBtn = document.getElementById('print-section-btn');
    if (printBtn) {
      printBtn.addEventListener('click', function() {
        window.print();
      });
    }
  })();
</script>
