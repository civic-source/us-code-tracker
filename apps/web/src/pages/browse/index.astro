---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TitleDirectory, { type TitleEntry } from '../../components/TitleDirectory.svelte';
import { TITLE_NAMES } from '../../data/title-names';
import { getTitleCategory } from '../../data/title-categories';

const allStatutes = await getCollection('statutes');

// Group statutes by title number
const byTitle = new Map<string, typeof allStatutes>();
for (const entry of allStatutes) {
  const titleNum = entry.data.usc_title;
  if (!byTitle.has(titleNum)) {
    byTitle.set(titleNum, []);
  }
  byTitle.get(titleNum)!.push(entry);
}

// Sort titles using natural alphanumeric collation (e.g. 18 before 18a before 19)
const sortedTitles = [...byTitle.entries()].sort(([a], [b]) =>
  a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' })
);

const totalSections = allStatutes.length;
const maxSections = Math.max(...[...byTitle.values()].map((e) => e.length), 1);
const base = import.meta.env.BASE_URL;

const titleEntries: TitleEntry[] = sortedTitles.map(([titleNum, entries]) => {
  const titleName = TITLE_NAMES[titleNum] ?? `Title ${titleNum}`;
  const pct = Math.round((entries.length / maxSections) * 100);
  return {
    num: titleNum,
    name: titleName,
    sectionCount: entries.length,
    pct,
    href: `${base}browse/title-${titleNum}/`,
    category: getTitleCategory(titleNum),
  };
});
---

<BaseLayout
  title="Browse Titles"
  description="Browse all 54 titles of the United States Code with instant search and subject filtering."
>
  <Breadcrumbs items={[{ label: 'Home', href: base }, { label: 'Browse' }]} />

  <div class="mb-6">
    <div class="inline-flex items-center gap-1.5 rounded-full bg-[var(--surface-sunken)] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[var(--civic-navy)] border border-[var(--border-subtle)] mb-3">
      <span>Official Codification Directory</span>
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
      United States Code
    </h1>
    <p class="mt-2 text-base text-[var(--text-secondary)] max-w-3xl leading-relaxed">
      The general and permanent laws of the United States, arranged into 54 statutory titles. Filter by subject or title number to inspect chapters, sections, and revision history.
    </p>
  </div>

  <TitleDirectory client:load titles={titleEntries} totalSections={totalSections} />
</BaseLayout>
