---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Count release point tags from the content-data submodule at build time
let releasePointCount = 0;
try {
  const { execSync } = await import('node:child_process');
  const tags = execSync('git tag --list "pl-*"', {
    cwd: process.cwd() + '/apps/web/content-data',
    encoding: 'utf8',
    timeout: 5000,
  }).trim();
  releasePointCount = tags ? tags.split('\n').length : 0;
} catch {
  // Submodule may not have tags in all environments
}

// Read recently changed sections from diff manifest and resolve actual URLs
interface RecentChange { title: string; section: string; entryId: string; sectionName: string; from: string; to: string; }
let recentChanges: RecentChange[] = [];
try {
  const { readFile, readdir } = await import('node:fs/promises');
  const { join } = await import('node:path');
  const publicDir = process.cwd() + '/apps/web/public/diffs';
  const manifestRaw = await readFile(join(publicDir, 'manifest.json'), 'utf8');
  const manifest = JSON.parse(manifestRaw) as { pairs: { from: string; to: string; changedSections: number }[] };
  const recentPair = manifest.pairs.filter(p => p.changedSections > 0).at(-1);
  if (recentPair) {
    const allEntries = await getCollection('statutes');
    const entryLookup = new Map<string, { id: string; name: string }>();
    for (const entry of allEntries) {
      const key = `title-${entry.data.usc_title}/section-${entry.data.usc_section}`;
      entryLookup.set(key, { id: entry.id, name: entry.data.title.replace(/^Section \S+ - /, '') });
    }

    const pairDir = join(publicDir, `${recentPair.from}_${recentPair.to}`);
    const titles = await readdir(pairDir).catch(() => [] as string[]);
    for (const titleDir of titles.slice(0, 8)) {
      const sections = await readdir(join(pairDir, titleDir)).catch(() => [] as string[]);
      for (const sectionFile of sections.slice(0, 3)) {
        const section = sectionFile.replace('.json', '');
        const key = `${titleDir}/${section}`;
        const found = entryLookup.get(key);
        if (found) {
          recentChanges.push({
            title: titleDir,
            section,
            entryId: found.id,
            sectionName: found.name,
            from: recentPair.from,
            to: recentPair.to,
          });
        }
      }
      if (recentChanges.length >= 8) break;
    }
  }
} catch {
  // Diffs may not exist yet
}

// Compute stats from content collection
let sectionCount = 59954; // fallback
let titleCount = 54; // fallback
try {
  const stats = await getCollection('statutes');
  sectionCount = stats.length;
  titleCount = new Set(stats.map(e => e.data.usc_title)).size;
} catch {
  // Fallback
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Home"
  description="Track changes to the United States Code with Git-based version control and diff history."
>
  <!-- USWDS Hero Section -->
  <section class="not-prose pb-8 pt-4 text-center font-sans">
    <div class="inline-flex items-center gap-1.5 rounded-full bg-navy/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-navy dark:bg-amber/15 dark:text-amber mb-4">
      <svg class="h-3.5 w-3.5 text-navy dark:text-amber" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V8.26l7-3.89v7.62z" />
      </svg>
      <span>Open Civic Technology</span>
    </div>
    <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-navy dark:text-gray-100 sm:text-5xl md:text-6xl" style="line-height: 1.15">
      US Code Tracker
    </h1>
    <p class="mx-auto mb-8 max-w-xl text-base text-slate sm:text-lg dark:text-gray-300 leading-relaxed">
      Every amendment and codification to federal statutory law, tracked transparently through Git version control.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href={`${base}browse/`}
        class="rounded-md bg-navy px-6 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-navy-dark dark:bg-teal dark:hover:bg-teal/90"
      >
        Browse all titles &rarr;
      </a>
      <a
        href="#how-it-works"
        class="rounded-md border border-gray-300 bg-white px-6 py-2.5 text-sm font-semibold text-slate shadow-2xs transition-colors hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
      >
        How it works
      </a>
    </div>
  </section>

  <!-- USWDS Metric Cards -->
  <div class="not-prose my-8 grid grid-cols-2 gap-4 font-sans sm:grid-cols-4">
    <div class="rounded-lg border border-gray-200 bg-warm-white p-4 text-center shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <p class="text-3xl font-extrabold text-navy dark:text-amber tabular-nums">{titleCount}</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate dark:text-gray-400">Titles</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-warm-white p-4 text-center shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <p class="text-3xl font-extrabold text-navy dark:text-amber tabular-nums">{sectionCount.toLocaleString()}</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate dark:text-gray-400">Sections</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-warm-white p-4 text-center shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <p class="text-3xl font-extrabold text-teal dark:text-teal-bright">PL 119-73</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate dark:text-gray-400">Current through</p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-warm-white p-4 text-center shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <p class="text-3xl font-extrabold text-teal dark:text-teal-bright tabular-nums">{releasePointCount > 0 ? releasePointCount : 230}</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate dark:text-gray-400">Release Points</p>
    </div>
  </div>

  <p class="not-prose mb-6 text-center text-xs text-gray-500 font-sans dark:text-gray-400">
    Synchronized directly with official XML releases from the Office of the Law Revision Counsel (House of Representatives).
  </p>

  <!-- Feature Grid: 4 Pillars of US Code Tracker -->
  <h2 id="how-it-works" class="text-navy dark:text-gray-100">What this project does</h2>
  <div class="not-prose my-6 grid grid-cols-1 gap-4 font-sans sm:grid-cols-2">
    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <div class="flex items-center gap-3 mb-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-navy/10 text-navy dark:bg-amber/15 dark:text-amber font-bold text-sm">
          XML
        </span>
        <h3 class="text-sm font-bold text-navy dark:text-gray-100">Official Data Ingestion</h3>
      </div>
      <p class="text-xs leading-relaxed text-slate dark:text-gray-400">
        Downloads official legislative XML releases from the Office of the Law Revision Counsel (OLRC) as soon as Congress publishes codifications.
      </p>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <div class="flex items-center gap-3 mb-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-teal/10 text-teal dark:bg-teal/20 dark:text-teal-bright font-bold text-sm">
          Git
        </span>
        <h3 class="text-sm font-bold text-navy dark:text-gray-100">Transparent Git Versioning</h3>
      </div>
      <p class="text-xs leading-relaxed text-slate dark:text-gray-400">
        Converts every title, chapter, and section into structured, plain-text files tracked by Git commits with cryptographic history.
      </p>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <div class="flex items-center gap-3 mb-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-teal/10 text-teal dark:bg-teal/20 dark:text-teal-bright font-bold text-sm">
          &Delta;
        </span>
        <h3 class="text-sm font-bold text-navy dark:text-gray-100">Word-Level Redline Diffs</h3>
      </div>
      <p class="text-xs leading-relaxed text-slate dark:text-gray-400">
        Generates authentic legal redlines with word-level additions and deletions so you can see exactly which words were added, removed, or amended.
      </p>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-2xs dark:border-gray-800 dark:bg-[#0B1926]">
      <div class="flex items-center gap-3 mb-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-navy/10 text-navy dark:bg-amber/15 dark:text-amber font-bold text-sm">
          §
        </span>
        <h3 class="text-sm font-bold text-navy dark:text-gray-100">Accessible Statutory Reading</h3>
      </div>
      <p class="text-xs leading-relaxed text-slate dark:text-gray-400">
        Provides an easy-to-read, navigable interface adhering to USWDS accessibility guidelines, customizable typefaces, and cross-reference links.
      </p>
    </div>
  </div>

  {recentChanges.length > 0 && (
    <h2 class="text-navy dark:text-gray-100">Recently amended sections</h2>
    <p class="not-prose mb-3 text-xs text-gray-500 font-sans dark:text-gray-400">
      Sections with text changes between {recentChanges[0]?.from.replace('pl-', 'PL ').replace('-', '-')} and {recentChanges[0]?.to.replace('pl-', 'PL ').replace('-', '-')}.
    </p>
    <div class="not-prose mb-6 overflow-hidden rounded-lg border border-gray-200 bg-white font-sans text-xs dark:border-gray-800 dark:bg-[#0B1926]">
      <ul class="divide-y divide-gray-100 dark:divide-gray-850">
        {recentChanges.map(change => (
          <li>
            <a
              href={`${base}statute/${change.entryId}/`}
              class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-warm-gray dark:hover:bg-gray-800"
            >
              <span class="h-2 w-2 rounded-full bg-teal shrink-0" aria-hidden="true"></span>
              <span class="font-mono text-xs font-semibold text-navy dark:text-amber shrink-0">{change.title.replace('title-', 'Title ')}</span>
              <span class="font-medium text-slate dark:text-gray-200 shrink-0">{change.section.replace('section-', '§ ')}</span>
              <span class="truncate text-gray-500 dark:text-gray-400">{change.sectionName}</span>
              <span class="ml-auto shrink-0 font-medium text-teal hover:underline dark:text-teal-bright">View diff &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="not-prose mt-6">
    <a
      href={`${import.meta.env.BASE_URL}browse/`}
      class="inline-flex items-center gap-2 rounded-md bg-teal px-6 py-3 font-sans text-sm font-semibold text-white shadow-xs transition-colors hover:bg-teal/90 focus:outline-none focus:ring-2 focus:ring-teal focus:ring-offset-2"
    >
      Browse all 54 Titles of the US Code &rarr;
    </a>
  </div>
</BaseLayout>
