---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Count release point tags from the content-data submodule at build time
let releasePointCount = 0;
try {
  const { execSync } = await import('node:child_process');
  const tags = execSync('git tag --list "pl-*"', {
    cwd: process.cwd() + '/apps/web/content-data',
    encoding: 'utf8',
    timeout: 5000,
  }).trim();
  releasePointCount = tags ? tags.split('\n').length : 0;
} catch {
  // Submodule may not have tags in all environments
}

// Read recently changed sections from diff manifest and resolve actual URLs
interface RecentChange {
  title: string;
  section: string;
  entryId: string;
  sectionName: string;
  from: string;
  to: string;
}

let recentChanges: RecentChange[] = [];
try {
  const { readFile, readdir } = await import('node:fs/promises');
  const { join } = await import('node:path');
  const publicDir = process.cwd() + '/apps/web/public/diffs';
  const manifestRaw = await readFile(join(publicDir, 'manifest.json'), 'utf8');
  const manifest = JSON.parse(manifestRaw) as {
    pairs: { from: string; to: string; changedSections: number }[];
  };
  const recentPair = manifest.pairs.filter((p) => p.changedSections > 0).at(-1);
  if (recentPair) {
    const allEntries = await getCollection('statutes');
    const entryLookup = new Map<string, { id: string; name: string }>();
    for (const entry of allEntries) {
      const key = `title-${entry.data.usc_title}/section-${entry.data.usc_section}`;
      entryLookup.set(key, {
        id: entry.id,
        name: entry.data.title.replace(/^Section \S+ - /, ''),
      });
    }

    const pairDir = join(publicDir, `${recentPair.from}_${recentPair.to}`);
    const titles = await readdir(pairDir).catch(() => [] as string[]);
    for (const titleDir of titles.slice(0, 8)) {
      const sections = await readdir(join(pairDir, titleDir)).catch(
        () => [] as string[]
      );
      for (const sectionFile of sections.slice(0, 3)) {
        const section = sectionFile.replace('.json', '');
        const key = `${titleDir}/${section}`;
        const found = entryLookup.get(key);
        if (found) {
          recentChanges.push({
            title: titleDir,
            section,
            entryId: found.id,
            sectionName: found.name,
            from: recentPair.from,
            to: recentPair.to,
          });
        }
      }
      if (recentChanges.length >= 8) break;
    }
  }
} catch {
  // Diffs may not exist yet
}

// Compute stats from content collection
let sectionCount = 59954; // fallback
let titleCount = 54; // fallback
try {
  const stats = await getCollection('statutes');
  sectionCount = stats.length;
  titleCount = new Set(stats.map((e) => e.data.usc_title)).size;
} catch {
  // Fallback
}

const base = import.meta.env.BASE_URL;

const popularTitles = [
  { num: '18', name: 'Crimes & Criminal Procedure', badge: 'Title 18' },
  { num: '26', name: 'Internal Revenue Code', badge: 'Title 26' },
  { num: '42', name: 'Public Health & Welfare', badge: 'Title 42' },
  { num: '5', name: 'Government Org & APA', badge: 'Title 5' },
  { num: '11', name: 'Bankruptcy', badge: 'Title 11' },
  { num: '35', name: 'Patents', badge: 'Title 35' },
];
---

<BaseLayout
  title="Home"
  description="Track changes to the United States Code with Git-based version control, legal redlines, and regulatory intelligence."
>
  <!-- OpenDesign Command Center Hero -->
  <section class="not-prose pb-10 pt-4 text-center font-sans">
    <!-- Live Status Pill -->
    <div class="inline-flex items-center gap-2 rounded-full border border-[var(--legal-valid)]/40 bg-[var(--legal-valid-bg)] px-3.5 py-1 text-xs font-semibold text-[var(--legal-valid)] mb-5 shadow-2xs">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--legal-valid)] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--legal-valid)]"></span>
      </span>
      <span>Official U.S. Code · Git Versioning & Redlines · Current through PL 119-73</span>
    </div>

    <h1 class="mb-4 text-4xl font-black tracking-tight text-[var(--text-primary)] sm:text-5xl md:text-6xl" style="line-height: 1.1">
      The Civic Legal Codebase
    </h1>
    <p class="mx-auto mb-8 max-w-2xl text-base text-[var(--text-secondary)] sm:text-lg leading-relaxed">
      Every federal statute, legislative amendment, and administrative regulation tracked with cryptographic Git history, authentic word-level redline diffs, and live regulatory radar.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href={`${base}browse/`}
        class="inline-flex items-center gap-2 rounded-lg bg-[var(--civic-navy)] px-6 py-3 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-[var(--civic-navy-dark)] focus:outline-none focus:ring-2 focus:ring-[var(--civic-action)] focus:ring-offset-2"
      >
        <span>Browse All 54 Titles</span>
        <span>&rarr;</span>
      </a>
      <a
        href={`${base}statute/title-18/chapter-7/section-111/`}
        class="inline-flex items-center gap-2 rounded-lg border border-[var(--border-default)] bg-[var(--surface-raised)] px-6 py-3 text-sm font-semibold text-[var(--text-primary)] shadow-2xs transition-colors hover:border-[var(--civic-action)] hover:text-[var(--civic-action)] focus:outline-none focus:ring-2 focus:ring-[var(--civic-action)]"
      >
        <span>Inspect Sample Statute (18 U.S.C. § 111)</span>
        <span class="text-xs text-[var(--text-muted)] font-mono">Inspector &rarr;</span>
      </a>
    </div>

    <!-- Quick Jump Chips -->
    <div class="mt-8 pt-6 border-t border-[var(--border-subtle)] max-w-3xl mx-auto">
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-3">
        Quick Access Codifications
      </p>
      <div class="flex flex-wrap justify-center gap-2">
        {popularTitles.map((t) => (
          <a
            href={`${base}browse/title-${t.num}/`}
            class="inline-flex items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-3 py-1 text-xs text-[var(--text-secondary)] transition-colors hover:border-[var(--civic-action)] hover:text-[var(--text-primary)] hover:shadow-2xs"
          >
            <span class="font-mono font-bold text-[var(--civic-navy)]">{t.badge}</span>
            <span>&middot;</span>
            <span>{t.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- OpenDesign Metric Cards -->
  <div class="not-prose my-6 grid grid-cols-2 gap-4 font-sans sm:grid-cols-4">
    <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-5 text-center shadow-2xs transition-all hover:border-[var(--civic-action)]">
      <p class="text-3xl font-extrabold text-[var(--civic-navy)] tabular-nums">{titleCount}</p>
      <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Statutory Titles</p>
      <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">General & permanent laws</p>
    </div>
    <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-5 text-center shadow-2xs transition-all hover:border-[var(--civic-action)]">
      <p class="text-3xl font-extrabold text-[var(--civic-navy)] tabular-nums">{sectionCount.toLocaleString()}</p>
      <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Codified Sections</p>
      <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">Tracked across 100+ years</p>
    </div>
    <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-5 text-center shadow-2xs transition-all hover:border-[var(--civic-action)]">
      <p class="text-3xl font-extrabold text-[var(--legal-valid)] tabular-nums">PL 119-73</p>
      <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Current Through</p>
      <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">Verified from House OLRC XML</p>
    </div>
    <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-5 text-center shadow-2xs transition-all hover:border-[var(--civic-action)]">
      <p class="text-3xl font-extrabold text-[var(--civic-action)] tabular-nums">{releasePointCount > 0 ? releasePointCount : 230}</p>
      <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">Release Points</p>
      <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">Cryptographic Git commits</p>
    </div>
  </div>

  <!-- OpenDesign Civic Legal Workbench: 4 Core Pillars -->
  <section class="not-prose my-10 font-sans">
    <div class="mb-6 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-[var(--surface-sunken)] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[var(--civic-navy)] border border-[var(--border-subtle)] mb-2">
        <span>The Civic Legal Workbench</span>
      </div>
      <h2 class="text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">
        Built for Legal Accuracy, Research, and Verification
      </h2>
      <p class="mt-1 text-sm text-[var(--text-secondary)] max-w-xl">
        Combining official House OLRC legislative XML with modern software engineering and judicial enrichment.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <!-- Pillar 1: Word-Level Redlines -->
      <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-6 shadow-2xs transition-all hover:shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--legal-action)]/10 text-[var(--legal-action)] font-mono font-bold text-base">
              &Delta;
            </span>
            <h3 class="text-base font-bold text-[var(--text-primary)]">Authentic Word-Level Redlines</h3>
          </div>
          <span class="rounded bg-[var(--diff-add-bg)] px-2 py-0.5 font-mono text-[11px] font-semibold text-[var(--diff-add-text)] border border-[var(--diff-add-border)]/30">
            + additions / &minus; deletions
          </span>
        </div>
        <p class="text-xs leading-relaxed text-[var(--text-secondary)] mb-4">
          Every Public Law passed by Congress amends specific statutory language. Our diff engine computes exact word-level additions and deletions so legal scholars can see legislative intent instantly.
        </p>
        <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-sunken)] p-3 font-mono text-xs leading-normal">
          <span class="text-[var(--text-muted)]">"Whoever forcibly assaults, resists, </span>
          <span class="rounded bg-[var(--diff-del-bg)] px-1 py-0.5 text-[var(--diff-del-text)] line-through">opposes</span>
          <span class="text-[var(--text-muted)]"> </span>
          <span class="rounded bg-[var(--diff-add-bg)] px-1 py-0.5 text-[var(--diff-add-text)] font-semibold">impedes, intimidates</span>
          <span class="text-[var(--text-muted)]">, or interferes with any person..."</span>
        </div>
      </div>

      <!-- Pillar 2: Shepard's & KeyCite Legal Signals -->
      <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-6 shadow-2xs transition-all hover:shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--legal-valid)]/10 text-[var(--legal-valid)] font-bold text-base">
              §
            </span>
            <h3 class="text-base font-bold text-[var(--text-primary)]">Judicial Validity Signals</h3>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--legal-valid)]" title="Active Law"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--legal-caution)]" title="Narrowed Precedent"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--legal-invalid)]" title="Unconstitutional / Struck Down"></span>
          </div>
        </div>
        <p class="text-xs leading-relaxed text-[var(--text-secondary)] mb-4">
          Integrated CourtListener case law annotations give you immediate Shepard's-style signals indicating whether statutory provisions have been upheld, narrowed, or ruled unconstitutional by federal courts.
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-md border border-[var(--legal-valid)]/30 bg-[var(--legal-valid-bg)] px-2.5 py-1 text-xs font-medium text-[var(--legal-valid)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--legal-valid)]"></span>
            Active In-Force Law
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-[var(--legal-caution)]/30 bg-[var(--legal-caution-bg)] px-2.5 py-1 text-xs font-medium text-[var(--legal-caution)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--legal-caution)]"></span>
            Narrowed Holding
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-[var(--legal-invalid)]/30 bg-[var(--legal-invalid-bg)] px-2.5 py-1 text-xs font-medium text-[var(--legal-invalid)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--legal-invalid)]"></span>
            Unconstitutional / Repealed
          </span>
        </div>
      </div>

      <!-- Pillar 3: Parallel Table of Authorities (eCFR PTOA) -->
      <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-6 shadow-2xs transition-all hover:shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--civic-navy)]/10 text-[var(--civic-navy)] font-mono font-bold text-base">
              CFR
            </span>
            <h3 class="text-base font-bold text-[var(--text-primary)]">eCFR Regulatory Mapping</h3>
          </div>
          <span class="rounded bg-[var(--surface-sunken)] px-2 py-0.5 font-mono text-[11px] font-medium text-[var(--text-muted)] border border-[var(--border-subtle)]">
            Parallel Table of Authorities
          </span>
        </div>
        <p class="text-xs leading-relaxed text-[var(--text-secondary)] mb-4">
          Statutes do not exist in isolation. Our automated eCFR PTOA pipeline connects statutory authority directly to agency implementing regulations across all 50 titles of the Code of Federal Regulations.
        </p>
        <div class="flex items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-sunken)] p-2.5 text-xs">
          <span class="font-mono font-bold text-[var(--civic-navy)]">20 U.S.C. § 1070</span>
          <span class="text-[var(--text-muted)]">&rarr;</span>
          <span class="font-mono text-[var(--text-primary)]">34 CFR Part 668</span>
          <span class="ml-auto text-[11px] text-[var(--text-muted)]">Dept of Education</span>
        </div>
      </div>

      <!-- Pillar 4: Real-Time Federal Register Radar -->
      <div class="rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] p-6 shadow-2xs transition-all hover:shadow-xs">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--civic-action)]/10 text-[var(--civic-action)] font-bold text-base">
              FR
            </span>
            <h3 class="text-base font-bold text-[var(--text-primary)]">Federal Register Radar</h3>
          </div>
          <span class="inline-flex items-center gap-1 rounded-full bg-[var(--legal-valid-bg)] px-2 py-0.5 text-[11px] font-semibold text-[var(--legal-valid)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--legal-valid)] animate-pulse"></span>
            Live API
          </span>
        </div>
        <p class="text-xs leading-relaxed text-[var(--text-secondary)] mb-4">
          Live queries directly to the Federal Register API show proposed rulemakings, public comment deadlines, and administrative action before changes are finalized into law.
        </p>
        <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-sunken)] p-2.5 text-xs flex items-center justify-between">
          <div class="truncate mr-2">
            <span class="font-semibold text-[var(--text-primary)]">Proposed Rulemaking Notice</span>
            <p class="text-[11px] text-[var(--text-muted)] truncate">Public comments close in 14 days</p>
          </div>
          <span class="rounded bg-[var(--surface-raised)] px-2 py-0.5 text-[11px] font-medium text-[var(--civic-action)] border border-[var(--border-subtle)] shrink-0">
            Submit Comment &rarr;
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Recently Amended Sections -->
  {recentChanges.length > 0 && (
    <section class="not-prose my-10 font-sans">
      <div class="mb-4 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Recently Amended Sections</h2>
          <p class="text-xs text-[var(--text-muted)]">
            Sections with text changes between {recentChanges[0]?.from.replace('pl-', 'PL ').replace('-', '-')} and {recentChanges[0]?.to.replace('pl-', 'PL ').replace('-', '-')}.
          </p>
        </div>
        <a
          href={`${base}browse/`}
          class="text-xs font-semibold text-[var(--civic-action)] hover:underline"
        >
          View all changes &rarr;
        </a>
      </div>

      <div class="overflow-hidden rounded-xl border border-[var(--border-default)] bg-[var(--surface-raised)] shadow-2xs">
        <ul class="divide-y divide-[var(--border-subtle)]">
          {recentChanges.map((change) => (
            <li>
              <a
                href={`${base}statute/${change.entryId}/`}
                class="flex items-center gap-3 px-4 py-3 text-xs transition-colors hover:bg-[var(--surface-sunken)]"
              >
                <span class="h-2 w-2 rounded-full bg-[var(--legal-valid)] shrink-0" aria-hidden="true"></span>
                <span class="font-mono font-bold text-[var(--civic-navy)] shrink-0">
                  {change.title.replace('title-', 'Title ')}
                </span>
                <span class="font-medium text-[var(--text-primary)] shrink-0">
                  {change.section.replace('section-', '§ ')}
                </span>
                <span class="truncate text-[var(--text-secondary)]">
                  {change.sectionName}
                </span>
                <span class="ml-auto shrink-0 font-medium text-[var(--civic-action)] hover:underline inline-flex items-center gap-1">
                  <span>View diff</span>
                  <span>&rarr;</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Bottom CTA Banner -->
  <section class="not-prose my-10 rounded-2xl border border-[var(--border-default)] bg-[var(--surface-sunken)] p-8 text-center font-sans">
    <h3 class="text-xl font-bold text-[var(--text-primary)] sm:text-2xl">
      Explore All 54 Titles of the United States Code
    </h3>
    <p class="mx-auto mt-2 max-w-lg text-sm text-[var(--text-secondary)]">
      From Title 1 (General Provisions) to Title 54 (National Park Service), discover the full hierarchy of codified federal statutory law.
    </p>
    <div class="mt-5">
      <a
        href={`${base}browse/`}
        class="inline-flex items-center gap-2 rounded-lg bg-[var(--civic-navy)] px-6 py-3 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-[var(--civic-navy-dark)] focus:outline-none focus:ring-2 focus:ring-[var(--civic-action)]"
      >
        <span>Open Title Directory</span>
        <span>&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>
