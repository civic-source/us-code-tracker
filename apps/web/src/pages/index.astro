          class="inline-flex items-center gap-2 rounded-lg bg-[var(--civic-navy)] px-6 py-3 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-[var(--civic-navy-dark)] focus:outline-none focus:ring-2 focus:ring-[var(--civic-action)]"
