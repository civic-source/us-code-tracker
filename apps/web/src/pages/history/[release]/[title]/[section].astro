---
import HistoricalReader from '../../../../components/HistoricalReader.astro';
import { readActiveHistoricalVersions } from '../../../../../../../scripts/lib/genuine-history-catalog';
import { historicalCollectionIdentity } from '../../../../../../../scripts/lib/historical-qualification';
import type { ProvisionVersion } from '@civic-source/types';
export async function getStaticPaths() {
  const versions = await readActiveHistoricalVersions();
  return versions.map(version => {
    const proof = version.sourceQualification!;
    return { params: { release: proof.releaseId, title: version.uscTitle, section: version.uscSection },
      props: { version, peers: versions.filter(peer => peer.sourceQualification!.releaseId === proof.releaseId),
        collectionId: historicalCollectionIdentity(proof.releaseId, proof.recipeSha256).releaseId } };
  });
}
interface Props { version: ProvisionVersion; peers: ProvisionVersion[]; collectionId: string }
---
<HistoricalReader {...Astro.props} activeAlias={true} />
